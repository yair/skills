#!/usr/bin/env python3
"""buzz-vouch — the owner vouches for an agent key on a Buzz relay (the buzz-genius skill).

Why: Buzz Desktop lets its owner @mention an agent only if the relay's agent
directory lists it, and the desktop builds that entry only for agents it
created and runs itself. An agent that lives elsewhere (a genius on its own box,
run by Buzz's headless harness) needs the same two owner signatures, made
here instead:

  1. a NIP-OA `auth` tag: the owner's BIP-340 signature over
     SHA256("nostr:agent-auth:" + agent_pubkey + ":" + conditions).
     It is PUBLIC (it proves ownership, it grants no signing power). The agent
     puts it in its kind-0 profile and its harness sends it with its events
     (BUZZ_AUTH_TAG), so this prints it for the agent's install step.
  2. a kind-30177 managed-agent policy event signed by the owner, d = agent
     pubkey, content {name, parallelism, respond_to[, respond_to_allowlist]};
     the desktop reads respond_to from it. Published with POST /events and a
     NIP-98 Authorization header, as the buzz CLI does.

The owner's secret key is read from the terminal with echo off (or from stdin
with --key-stdin, e.g. piped from a password manager), kept in memory only,
and never written, logged or passed on argv. Standard library only, so it runs
on any box with Python 3 (any box).

  buzz-vouch AGENT [--name N] [--respond-to anyone|owner-only|allowlist]
             [--allowlist HEX,…] [--parallelism N] [--conditions C]
             [--relay URL] [--key-stdin] [--yes] [--tag-only]   (relay: $BUZZ_RELAY_URL or ~/.config/buzz/relay)
  buzz-vouch --self-test BIP340_VECTORS.csv

AGENT is the agent's npub1… or 64-hex public key. Output: the auth tag as one
JSON line on stdout; progress on stderr.
"""
import argparse, base64, csv, getpass, hashlib, json, os, sys, time, urllib.error, urllib.request, uuid

# --- BIP-340 Schnorr over secp256k1 (after the BIP's reference code) ---------
# Plain Python integers: correct (see --self-test) but NOT constant-time, so
# timing can leak bits of the key to a local observer. Acceptable for a
# one-shot signature on the owner's own machine; do not reuse this code where
# it signs repeatedly with a long-lived key (a service, a relay, a bot).
P = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEFFFFFC2F
N = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141
G = (0x79BE667EF9DCBBAC55A06295CE870B07029BFCDB2DCE28D959F2815B16F81798,
     0x483ADA7726A3C4655DA4FBFC0E1108A8FD17B448A68554199C47D08FFB10D4B8)


def _add(p1, p2):
    if p1 is None:
        return p2
    if p2 is None:
        return p1
    if p1[0] == p2[0] and p1[1] != p2[1]:
        return None
    if p1 == p2:
        lam = 3 * p1[0] * p1[0] * pow(2 * p1[1], P - 2, P) % P
    else:
        lam = (p2[1] - p1[1]) * pow(p2[0] - p1[0], P - 2, P) % P
    x = (lam * lam - p1[0] - p2[0]) % P
    return (x, (lam * (p1[0] - x) - p1[1]) % P)


def _mul(pt, k):
    r = None
    for i in range(256):
        if (k >> i) & 1:
            r = _add(r, pt)
        pt = _add(pt, pt)
    return r


def _b(x):
    return x.to_bytes(32, "big")


def _i(b):
    return int.from_bytes(b, "big")


def _th(tag, msg):
    t = hashlib.sha256(tag.encode()).digest()
    return hashlib.sha256(t + t + msg).digest()


def _lift_x(x):
    if x >= P:
        return None
    c = (pow(x, 3, P) + 7) % P
    y = pow(c, (P + 1) // 4, P)
    if y * y % P != c:
        return None
    return (x, y if y % 2 == 0 else P - y)


def pubkey_of(sk):
    d = _i(sk)
    if not 1 <= d < N:
        raise ValueError("secret key out of range")
    return _b(_mul(G, d)[0])


def schnorr_sign(msg, sk, aux):
    d0 = _i(sk)
    if not 1 <= d0 < N:
        raise ValueError("secret key out of range")
    pt = _mul(G, d0)
    d = d0 if pt[1] % 2 == 0 else N - d0
    t = bytes(a ^ b for a, b in zip(_b(d), _th("BIP0340/aux", aux)))
    k0 = _i(_th("BIP0340/nonce", t + _b(pt[0]) + msg)) % N
    if k0 == 0:
        raise ValueError("nonce is zero")
    r = _mul(G, k0)
    k = k0 if r[1] % 2 == 0 else N - k0
    e = _i(_th("BIP0340/challenge", _b(r[0]) + _b(pt[0]) + msg)) % N
    sig = _b(r[0]) + _b((k + e * d) % N)
    if not schnorr_verify(msg, _b(pt[0]), sig):
        raise RuntimeError("produced signature does not verify")
    return sig


def schnorr_verify(msg, pk, sig):
    if len(pk) != 32 or len(sig) != 64:
        return False
    pt = _lift_x(_i(pk))
    r, s = _i(sig[:32]), _i(sig[32:])
    if pt is None or r >= P or s >= N:
        return False
    e = _i(_th("BIP0340/challenge", sig[:32] + pk + msg)) % N
    rr = _add(_mul(G, s), _mul(pt, N - e))
    return rr is not None and rr[1] % 2 == 0 and rr[0] == r


# --- NIP-19 bech32 (npub / nsec) ---------------------------------------------
_CS = "qpzry9x8gf2tvdw0s3jn54khce6mua7l"


def _polymod(values):
    gen = [0x3B6A57B2, 0x26508E6D, 0x1EA119FA, 0x3D4233DD, 0x2A1462B3]
    chk = 1
    for v in values:
        top = chk >> 25
        chk = (chk & 0x1FFFFFF) << 5 ^ v
        for i in range(5):
            chk ^= gen[i] if (top >> i) & 1 else 0
    return chk


def key32(s, hrp):
    """Decode a 64-hex key or a bech32 `hrp1…` key to 32 bytes."""
    s = s.strip()
    if len(s) == 64 and all(c in "0123456789abcdefABCDEF" for c in s):
        return bytes.fromhex(s)
    s = s.lower()
    if not s.startswith(hrp + "1"):
        raise ValueError(f"expected {hrp}1… or 64 hex characters")
    data = [_CS.find(c) for c in s[len(hrp) + 1:]]
    if -1 in data or len(data) < 7:
        raise ValueError("bad bech32 characters")
    if _polymod([ord(x) >> 5 for x in hrp] + [0] + [ord(x) & 31 for x in hrp] + data) != 1:
        raise ValueError("bech32 checksum mismatch")
    acc, bits, out = 0, 0, []
    for v in data[:-6]:
        acc = (acc << 5) | v
        bits += 5
        while bits >= 8:
            bits -= 8
            out.append((acc >> bits) & 0xFF)
    if len(out) != 32:
        raise ValueError("wrong key length")
    return bytes(out)


# --- Nostr events --------------------------------------------------------------
def sign_event(sk, kind, tags, content):
    pk = pubkey_of(sk).hex()
    created = int(time.time())
    ser = json.dumps([0, pk, created, kind, tags, content], separators=(",", ":"), ensure_ascii=False)
    eid = hashlib.sha256(ser.encode()).digest()
    sig = schnorr_sign(eid, sk, os.urandom(32))
    return {"id": eid.hex(), "pubkey": pk, "created_at": created, "kind": kind,
            "tags": tags, "content": content, "sig": sig.hex()}


def auth_tag(owner_sk, agent_pk_hex, conditions):
    msg = hashlib.sha256(f"nostr:agent-auth:{agent_pk_hex}:{conditions}".encode()).digest()
    sig = schnorr_sign(msg, owner_sk, os.urandom(32))
    return ["auth", pubkey_of(owner_sk).hex(), conditions, sig.hex()]


def verify_auth_tag(tag, agent_pk_hex):
    if len(tag) != 4 or tag[0] != "auth" or tag[1] == agent_pk_hex:
        return False
    msg = hashlib.sha256(f"nostr:agent-auth:{agent_pk_hex}:{tag[2]}".encode()).digest()
    return schnorr_verify(msg, bytes.fromhex(tag[1]), bytes.fromhex(tag[3]))


def post_event(relay, owner_sk, event):
    url = relay.rstrip("/") + "/events"
    body = json.dumps(event, separators=(",", ":"), ensure_ascii=False).encode()
    nip98 = sign_event(owner_sk, 27235, [["u", url], ["method", "POST"], ["nonce", str(uuid.uuid4())],
                                         ["payload", hashlib.sha256(body).hexdigest()]], "")
    req = urllib.request.Request(url, data=body, method="POST", headers={
        "Content-Type": "application/json",
        "Authorization": "Nostr " + base64.b64encode(json.dumps(nip98, separators=(",", ":")).encode()).decode()})
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return resp.status, resp.read().decode(errors="replace")
    except urllib.error.HTTPError as e:
        return e.code, e.read().decode(errors="replace")


# --- self-test against BIP-340's official vectors -------------------------------
def self_test(path):
    ok = True
    with open(path, newline="") as f:
        for row in csv.DictReader(f):
            msg, pk, sig = bytes.fromhex(row["message"]), bytes.fromhex(row["public key"]), bytes.fromhex(row["signature"])
            want = row["verification result"] == "TRUE"
            got = schnorr_verify(msg, pk, sig)
            line = f"vector {row['index']}: verify {'ok' if got == want else 'FAIL'}"
            if row["secret key"]:
                sk, aux = bytes.fromhex(row["secret key"]), bytes.fromhex(row["aux_rand"])
                same = pubkey_of(sk) == pk and schnorr_sign(msg, sk, aux) == sig
                line += f", sign {'ok' if same else 'FAIL'}"
                ok &= same
            ok &= got == want
            print(line)
    print("BIP-340 self-test", "PASSED" if ok else "FAILED")
    return 0 if ok else 1


def _relay_file():
    try:
        return open(os.path.expanduser("~/.config/buzz/relay")).read().strip() or None
    except OSError:
        return None


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("agent", nargs="?", help="agent npub1… or 64-hex pubkey")
    ap.add_argument("--name", help="agent display name for the policy event (default: the agent's short key)")
    ap.add_argument("--respond-to", default="anyone", choices=["anyone", "owner-only", "allowlist"])
    ap.add_argument("--allowlist", default="", help="comma-separated hex pubkeys, for --respond-to allowlist")
    ap.add_argument("--parallelism", type=int, default=2)
    ap.add_argument("--conditions", default="", help="NIP-OA conditions (default empty: unrestricted)")
    ap.add_argument("--relay", default=os.environ.get("BUZZ_RELAY_URL") or _relay_file(),
                    help="relay base URL (default: $BUZZ_RELAY_URL, else ~/.config/buzz/relay)")
    ap.add_argument("--key-stdin", action="store_true", help="read the owner secret from stdin instead of the terminal")
    ap.add_argument("--yes", action="store_true", help="publish without asking")
    ap.add_argument("--tag-only", action="store_true", help="print the auth tag, publish nothing")
    ap.add_argument("--self-test", metavar="CSV", help="check against BIP-340 test-vectors.csv and exit")
    a = ap.parse_args()
    if a.self_test:
        return self_test(a.self_test)
    if not a.agent:
        ap.error("AGENT is required")
    if not a.relay:
        ap.error("no relay: pass --relay URL, set BUZZ_RELAY_URL, or write it to ~/.config/buzz/relay")
    agent = key32(a.agent, "npub").hex()
    if a.relay.startswith("ws"):
        a.relay = "http" + a.relay[2:]

    raw = sys.stdin.readline() if a.key_stdin else getpass.getpass("Owner Buzz secret key (nsec1… or hex; hidden): ")
    owner_sk = key32(raw, "nsec")
    del raw
    owner = pubkey_of(owner_sk).hex()
    if owner == agent:
        sys.exit("the owner key and the agent key are the same")

    tag = auth_tag(owner_sk, agent, a.conditions)
    if not verify_auth_tag(tag, agent):
        sys.exit("internal error: the auth tag does not verify")
    print(f"owner {owner}\nagent {agent}\nauth tag signed and verified", file=sys.stderr)

    if not a.tag_only:
        content = {"name": a.name or agent[:8], "parallelism": a.parallelism, "respond_to": a.respond_to}
        allow = [x.strip().lower() for x in a.allowlist.split(",") if x.strip()]
        if a.respond_to == "allowlist":
            content["respond_to_allowlist"] = allow
        event = sign_event(owner_sk, 30177, [["d", agent]], json.dumps(content, separators=(",", ":")))
        print(f"policy event (kind 30177): {event['content']}", file=sys.stderr)
        if not a.yes:
            try:
                tty = open("/dev/tty")
            except OSError:
                sys.exit("no terminal to confirm on; check the policy above and rerun with --yes")
            with tty:
                print(f"Publish it to {a.relay}? [y/N] ", end="", file=sys.stderr, flush=True)
                if tty.readline().strip().lower() not in ("y", "yes"):
                    sys.exit("not published")
        status, text = post_event(a.relay, owner_sk, event)
        print(f"relay answered {status}: {text[:300]}", file=sys.stderr)
        if status // 100 != 2:
            sys.exit(1)
    del owner_sk
    print(json.dumps(tag, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    sys.exit(main())
