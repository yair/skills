# <GENIUS> as a native Buzz agent. Sourced by the host's buzz-agent launcher
# (set -a), which adds BUZZ_PRIVATE_KEY and BUZZ_AUTH_TAG from
# ~/.config/buzz/<GENIUS>.{key,authtag} and BUZZ_ACP_SYSTEM_PROMPT_FILE from
# <GENIUS>.md beside this file. No secrets here. Installed root-owned by the
# host admin; <…> values are the genius's, {…} values the host admin's.
BUZZ_RELAY_URL=wss://<relay host>
# The owner; the auth tag, when present, takes precedence.
BUZZ_ACP_AGENT_OWNER=<owner hex pubkey>

# Codex through its ACP adapter (the host kit's install, kept current).
# `buzz-acp models --agent-command codex-acp --agent-args ""` lists the models.
BUZZ_ACP_AGENT_COMMAND=/usr/local/bin/codex-acp
BUZZ_ACP_AGENT_ARGS=
BUZZ_ACP_MODEL=<model id>
BUZZ_ACP_EFFORT_LEVEL=medium
NO_BROWSER=1

# The fence. Codex may write only in its workspace (~/.buzz/<GENIUS>) and /tmp,
# and never asks to escalate (approval_policy=never), so the harness's
# auto-approval has nothing to approve. Network stays on for the buzz CLI,
# Engine and brain. The harness's own permission override stays off: it would
# send `bypassPermissions`, a mode the Codex adapter does not define.
BUZZ_ACP_PERMISSION_MODE=default
INITIAL_AGENT_MODE=workspace-write
CODEX_CONFIG='{"approval_policy":"never","sandbox_mode":"workspace-write","sandbox_workspace_write":{"network_access":true}}'

# Talks with anyone in the room (the instructions say: orders only from the
# owner). One session per thread; two Codex processes at most; started on the
# first mention and stopped again after ten idle minutes.
BUZZ_ACP_RESPOND_TO=anyone
BUZZ_ACP_SESSION_POLICY=thread
BUZZ_ACP_AGENTS=2
BUZZ_ACP_LAZY_POOL=true
BUZZ_ACP_IDLE_POOL_SLEEP=600

# The account's own tools first (engine, brain, codex), then the system's.
PATH=<home>/.local/bin:/usr/local/bin:/usr/bin:/bin
RUST_LOG=info
